# Core
TOOLKIT_ENV=dev
TOOLKIT_LOG_LEVEL=INFO
TOOLKIT_DATA_DIR=./data

# Which adapter is active
TOOLKIT_SHEET_ADAPTER=csv
TOOLKIT_MAIL_ADAPTER=fake
TOOLKIT_CALENDAR_ADAPTER=fake

# CSV adapter
TOOLKIT_CSV_PATH=./data/csv

# Google (mail + calendar, when you get there)
TOOLKIT_GOOGLE_CREDENTIALS=./data/google-credentials.json
TOOLKIT_GOOGLE_TOKEN=./data/google-token.json

# Telegram
TOOLKIT_TELEGRAM_TOKEN=
TOOLKIT_TELEGRAM_CHAT=

# Server
TOOLKIT_HOST=127.0.0.1
TOOLKIT_PORT=8000