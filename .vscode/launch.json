{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: all non-live",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "not live", "-v"],
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "CLI (ask)",
      "type": "debugpy",
      "request": "launch",
      "module": "toolkit",
      "args": ["ask", "how many rows are in Sales?"],
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    }
  ]
}
